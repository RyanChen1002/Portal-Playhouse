{
  "name": "portal-playhouse",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "runtime"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:frontend": "node tools/build-frontend.cjs",
    "test:frontend": "node --test frontend/games/*.test.mjs frontend/live-state.test.mjs tools/build-frontend.test.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:db": "supabase test db",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p runtime/tsconfig.json",
    "db:keys": "test -f supabase/signing_keys.json || { echo '[]' > supabase/signing_keys.json && supabase gen signing-key --algorithm ES256 --append || { rm -f supabase/signing_keys.json; exit 1; }; }",
    "db:start": "npm run db:keys && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:runtime": "npm --workspace runtime run test",
    "runtime:dev": "npm --workspace runtime run dev"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
